#include <winver.h>

GLFW_ICON ICON "@PX_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PX_VERSION_MAJOR@,@PX_VERSION_MINOR@,@PX_VERSION_PATCH@,@PX_VERSION_TWEAK@
 PRODUCTVERSION @PX_VERSION_MAJOR@,@PX_VERSION_MINOR@,@PX_VERSION_PATCH@,@PX_VERSION_TWEAK@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Stealth"
            VALUE "FileDescription",  "Paradox Editor"
            VALUE "FileVersion",      "@PX_VERSION@"
            VALUE "InternalName",     "Paradox"
            VALUE "LegalCopyright",   "Copyright Stealth. All Rights Reserved."
            VALUE "OriginalFilename", "Paradox-Editor.exe"
            VALUE "ProductName",      "Paradox"
            VALUE "ProductVersion",   "@PX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END