#include <winver.h>

@PX_ICON_RESOURCE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PX_PROJECT_VERSION_MAJOR@,@PX_PROJECT_VERSION_MINOR@,@PX_PROJECT_VERSION_PATCH@,@PX_PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PX_VERSION_MAJOR@,@PX_VERSION_MINOR@,@PX_VERSION_PATCH@,@PX_VERSION_TWEAK@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "@PX_PROJECT_AUTHOR@"
            VALUE "FileDescription",  "@PX_PROJECT_NAME@"
            VALUE "FileVersion",      "@PX_PROJECT_VERSION@"
            VALUE "InternalName",     "Paradox"
            VALUE "LegalCopyright",   "@PX_PROJECT_COPYRIGHT@"
            VALUE "OriginalFilename", "Runtime.exe"
            VALUE "ProductName",      "Paradox Runtime"
            VALUE "ProductVersion",   "@PX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END